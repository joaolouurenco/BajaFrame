{
  "name": "bajaframe",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Visualizador paramétrico e local de um frame Baja.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "audit:portable": "node scripts/audit-portable.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "lucide-react": "^1.46.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.2",
    "tsx": "^4.21.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
